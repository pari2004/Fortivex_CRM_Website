# ---------------------------------------------------------------------------
# Copy this file to .env.local and fill in your real hosts.
# Both variables are read at BUILD time, so rebuild after changing them.
# ---------------------------------------------------------------------------

# Where this marketing site is served (no trailing slash).
# Used for metadata, canonical URLs, robots.txt and sitemap.xml.
NEXT_PUBLIC_SITE_URL=https://fortivex.ai

# Where the Fortivex CRM app is served (no trailing slash).
# Drives the "Log in" link, signup link, and the URL shown in product mockups.
# Local development:  http://localhost:3002
NEXT_PUBLIC_APP_URL=https://app.fortivex.ai
